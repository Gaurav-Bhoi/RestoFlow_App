# Copy to .env.stallion.local. These values never enter react-native-config.
STALLION_DEV_APP_TOKEN=
STALLION_PROD_APP_TOKEN=
# Public verification keys can be committed under stallion/public/.
STALLION_DEV_PUBLIC_KEY_PATH=
STALLION_PROD_PUBLIC_KEY_PATH=
# Copy real bucket paths from the Stallion console; do not invent them.
STALLION_DEV_UPLOAD_PATH=
STALLION_PROD_UPLOAD_PATH=
# Optional dedicated project CI tokens (never application tokens).
STALLION_DEV_CI_TOKEN=
STALLION_PROD_CI_TOKEN=
STALLION_DEV_PRIVATE_KEY=
STALLION_PROD_PRIVATE_KEY=
